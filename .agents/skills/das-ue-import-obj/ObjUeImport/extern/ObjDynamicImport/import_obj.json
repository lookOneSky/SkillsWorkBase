{
  "enabled_plugins": [
    "PythonScriptPlugin",
    "EditorScriptingUtilities"
  ],
  "commandlet_arguments": [
    "-unattended",
    "-nop4",
    "-nosplash",
    "-AllowCommandletRendering",
    "-stdout",
    "-FullStdOutLogOutput"
  ],
  "destination_root": "/Game/ObjImport/{timestamp}",
  "data_info_directory": "DasDataInfo",
  "asset_name_prefix": "SM_",
  "parent_material": "/Game/DasMaterialObj/MI_Model.MI_Model",
  "batch_parent_material": {
    "enabled": true
  },
  "validate_parent_material_parameters": true,
  "require_parent_material_instances": true,
  "build_static_mesh_ddc": true,
  "common_meshes_properties": {
    "compute_weighted_normals": true
  },
  "cleanup": {
    "unload_after_import": true,
    "interval": 1
  },
  "import_task": {
    "automated": true,
    "replace_existing": true,
    "replace_existing_settings": true,
    "save": true,
    "async_": false
  }
}
